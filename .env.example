# Sepolia only. Do not point these at Ethereum mainnet.

# Safe multisig. Treasury and the pending owner of LabxRaffle.
SAFE_ADDRESS=

# Deployer key configures native VRF billing and proposes ownership to the Safe.
# AddVrfConsumer also uses this key and requires it to own the VRF subscription.
# The Safe must call acceptOwnership. Do not use the Safe key here.
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=

# Chainlink VRF v2.5 subscription funded with native Sepolia ETH.
# DeploySepolia explicitly enables native billing before proposing Safe ownership.
# The subscription owner registers the consumer; the Safe separately accepts ownership.
# Coordinator and key hash are pinned constants in DeploySepolia.s.sol.
VRF_SUBSCRIPTION_ID=

# Exact PUBLISHED_TERMS_HASH from web/lib/published-terms.ts. Review before deployment.
TERMS_HASH=

# Optional ETH membership purchases, independent of native VRF billing. Off by default.
# Router, WETH, and the feed are immutable once wired.
WIRE_ETH_PATH=false
UNISWAP_POOL_FEE=3000

# Web. An address selects an independently approved v2 manifest in deployment.ts.
# The approved manifest list is currently empty. Leave the address unset until reviewed.
# Never invent a deployment identity.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RAFFLE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Must equal the actual website origin for signed backend requests.
NEXT_PUBLIC_SITE_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM=

# Historical non-entry check-in only. Points do not grant entries. Never expose this token.
BOT_CHECKIN_TOKEN=

# Required on Vercel. Missing durable storage fails closed.
# Local development may use web/data/store.json in one process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
