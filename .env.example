# Sepolia only. Do not point these at Ethereum mainnet.

# Safe multisig. Treasury and the pending owner of LabxRaffle.
SAFE_ADDRESS=

# Deployer key used only to deploy and to propose ownership to the Safe.
# The Safe must call acceptOwnership. Do not use the Safe key here.
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=

# Chainlink VRF v2.5 subscription funded with Sepolia LINK.
# Coordinator default: 0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
# 500 gwei key hash default: 0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_SUBSCRIPTION_ID=
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae

# Server key that signs complimentary entries. Set the address on the contract.
AMOE_SIGNER=
AMOE_SIGNER_PRIVATE_KEY=

# keccak256 of the published terms. Pass as bytes32 to the deploy script.
TERMS_HASH=

# Optional ETH route. Off by default. Router, WETH, and the feed are immutable once wired.
WIRE_ETH_PATH=false
UNISWAP_POOL_FEE=3000

# Web. Leave NEXT_PUBLIC_RAFFLE_ADDRESS empty until LabxRaffle is deployed on Sepolia.
# The bench stays local and on-chain controls are soft-disabled when that value is unset.
# Do not invent a live raffle address here. Do not point these at Ethereum mainnet.
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RAFFLE_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Public site origin for sitemap and canonical URLs. Leave empty to use the Vercel bench default.
NEXT_PUBLIC_SITE_URL=

# Resend
RESEND_API_KEY=
RESEND_FROM=

# Bot-gated check-in. Never ship this value in the client.
BOT_CHECKIN_TOKEN=
CAPTCHA_SECRET=

# Optional persistence on Vercel. Without it, local dev uses web/data/store.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional hCaptcha upgrade. The built-in challenge runs when this is unset.
HCAPTCHA_SECRET=
